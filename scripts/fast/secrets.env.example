# Deployment-only secret names. Keep real values in the host's mode-0600
# ~/atlas-deploy/product/secrets.json; never commit or publish them as artifacts.
ATLAS_DB_PASSWORD=
ATLAS_RUNTIME_PASSWORD=
ATLAS_WORKER_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
ATLAS_OIDC_CLIENT_SECRET=
ATLAS_USER_PASSWORD=
ATLAS_CURSOR_KEY=
ATLAS_BACKUP_KEY=
# Mount BACKUP_ROOT on a separate physical fault domain for production.
ATLAS_BACKUP_ROOT=
ATLAS_ALERT_WEBHOOK_URL=
ATLAS_ALERT_WEBHOOK_SECRET_FILE=
# Optional public/LAN URL. Defaults to https://192.168.10.10:15809.
ATLAS_BASE_URL=
