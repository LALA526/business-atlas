# Non-sensitive operational paths. BACKUP_ROOT must be encrypted storage in a
# separate physical fault domain. The encryption key must remain elsewhere.
ATLAS_BACKUP_ROOT=/mnt/atlas-offsite-backup
ATLAS_WAL_ROOT=/var/lib/atlas/wal
ATLAS_BACKUP_KEY_FILE=/var/lib/atlas/secrets/backup-encryption.key
ATLAS_RESTORE_WORK_ROOT=/var/lib/atlas/restore-drills
ATLAS_ALERT_WEBHOOK_URL=https://ops.example.invalid/business-atlas-alerts
ATLAS_ALERT_WEBHOOK_SECRET_FILE=/var/lib/atlas/secrets/alert-webhook.key
