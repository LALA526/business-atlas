{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Error Pattern v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "patternId",
    "symptom",
    "rootCause",
    "trigger",
    "detector",
    "prevention",
    "regressionTestId",
    "appliesTo",
    "reviewer",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "patternId": {
      "type": "string",
      "minLength": 1
    },
    "symptom": {
      "type": "string",
      "minLength": 1
    },
    "rootCause": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "detector": {
      "type": "string",
      "minLength": 1
    },
    "prevention": {
      "type": "string",
      "minLength": 1
    },
    "regressionTestId": {
      "type": "string",
      "minLength": 1
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "reviewed",
        "active",
        "retired"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}