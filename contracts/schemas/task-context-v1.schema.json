{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:business-atlas:TaskContext:1.0",
  "$defs": {
    "TaskContext": {
      "type": "object",
      "properties": {
        "contextId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "baselineId": {
          "type": "string",
          "format": "uuid"
        },
        "policyEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "candidate",
            "executable"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetChange"
          }
        },
        "preserve": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          }
        },
        "requiredRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "impactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "approvalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "acceptanceCases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          }
        },
        "knowledgeRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unknown"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "stale",
            "insufficient"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "contextId",
        "projectId",
        "taskId",
        "baselineId",
        "policyEpoch",
        "phase",
        "digest",
        "target",
        "preserve",
        "requiredRefs",
        "evidence",
        "impactIds",
        "approvalIds",
        "acceptanceCases",
        "knowledgeRequirements",
        "unknowns",
        "status",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "Unknown": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocking"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing",
            "conflict",
            "insufficient",
            "unverified",
            "stale",
            "not_applicable",
            "restricted_context"
          ]
        },
        "nextAction": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          }
        }
      },
      "required": [
        "key",
        "description",
        "severity",
        "reason"
      ],
      "additionalProperties": false
    },
    "RevisionRef": {
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "format": "uuid"
        },
        "revisionId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "unitId",
        "revisionId"
      ],
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/RevisionRef"
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "support": {
          "type": "string",
          "enum": [
            "supports",
            "refutes",
            "contextual"
          ]
        },
        "captureKind": {
          "type": "string",
          "enum": [
            "rawCaptured",
            "verifiedScript",
            "reconstructed",
            "proposed",
            "humanAttestation"
          ]
        }
      },
      "required": [
        "source",
        "locator",
        "support",
        "captureKind"
      ],
      "additionalProperties": false
    },
    "SourceLocator": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "git",
            "url",
            "test",
            "human",
            "document"
          ]
        },
        "path": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "blobSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "uri": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "TargetChange": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add",
            "revise",
            "retire",
            "preserve",
            "revalidate"
          ]
        },
        "current": {
          "$ref": "#/$defs/RevisionRef"
        },
        "candidate": {
          "$ref": "#/$defs/RevisionRef"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "description",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/TaskContext"
}
