{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "status",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "project": {
      "type": "string"
    },
    "status": {
      "const": "planned"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "title",
          "ownerRole",
          "modules",
          "dependsOn",
          "repoPaths",
          "implementation",
          "acceptance",
          "testIds",
          "productIds",
          "workpackageIds",
          "resourceLocks",
          "requiredOutputs",
          "status",
          "plannedBranch",
          "actualEvidence",
          "requirementIds",
          "knowledgeOutputs",
          "contractRefs",
          "operationIds"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerRole": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repoPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation": {
            "type": "string"
          },
          "acceptance": {
            "type": "string"
          },
          "testIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "productIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workpackageIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceLocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredOutputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "plannedBranch": {
            "type": "string"
          },
          "actualEvidence": {
            "type": "null"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledgeOutputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contractRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
