{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-atlas.local/schemas/atlas-proposal-v1.0.schema.json",
  "title": "Business Atlas native candidate proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "packageId", "sourceNamespace", "entries"],
  "properties": {
    "formatVersion": { "const": "AtlasProposal/1.0" },
    "packageId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sourceNamespace": { "type": "string", "minLength": 1, "maxLength": 500 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId", "externalType", "title", "kind", "factKind", "verification", "applicability", "body", "categoryKeys"],
        "properties": {
          "externalId": { "type": "string", "minLength": 1 },
          "externalType": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "factKind": { "enum": ["observed", "documented_intent", "inferred", "assumption"] },
          "verification": { "enum": ["unverified", "contradicted"] },
          "applicability": { "type": "object" },
          "body": { "type": "object" },
          "categoryKeys": { "type": "array", "items": { "type": "string" } },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "externalId": { "type": ["string", "null"] }
        }
      }
    }
  }
}
