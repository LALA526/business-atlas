{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Tool Contract v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "description",
    "requiredScopes",
    "destructive",
    "idempotent",
    "inputSchema",
    "outputSchema",
    "auditActions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requiredScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "destructive": {
      "type": "boolean"
    },
    "idempotent": {
      "type": "boolean"
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "auditActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rateLimitPolicy": {
      "type": "string"
    },
    "approvalPolicy": {
      "type": "string"
    }
  }
}