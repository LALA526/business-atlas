{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-atlas.local/schemas/akp-v0.1.schema.json",
  "title": "Atlas Knowledge Package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "entities", "assertions", "businessStructures", "technicalStructures", "sources", "unknownsAndConflicts", "importProvenance"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "packageId", "sourceProjectId", "projectName", "generatedAt", "producer", "sourceRevision", "importPurpose", "declaredScope"],
      "properties": {
        "formatVersion": { "const": "AKP/0.1" },
        "packageId": { "type": "string", "pattern": "^AKP-[A-Za-z0-9._-]+$" },
        "sourceProjectId": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "producer": { "type": "object", "required": ["kind", "identity"], "properties": { "kind": { "enum": ["external-agent", "human", "tool"] }, "identity": { "type": "string" }, "model": { "type": "string" }, "provider": { "type": "string" } } },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "importPurpose": { "type": "string", "minLength": 1 },
        "declaredScope": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stableExternalId", "typeId", "name", "properties", "categoryAssignments", "applicableContext", "verificationStatus"],
        "properties": {
          "stableExternalId": { "type": "string", "minLength": 1 },
          "typeId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "properties": { "type": "object" },
          "categoryAssignments": { "type": "array", "items": { "type": "string" } },
          "applicableContext": { "type": "object" },
          "verificationStatus": { "enum": ["observed", "documented_intent", "inferred", "unknown", "conflicting"] },
          "sourceIds": { "type": "array", "items": { "type": "string" } },
          "sensitivity": { "enum": ["public", "internal", "sensitive", "restricted"] },
          "permissions": { "type": "object" },
          "extra": { "type": "object" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stableExternalId", "subject", "predicate", "qualifiers", "sourceRefs", "verificationStatus"],
        "properties": {
          "stableExternalId": { "type": "string" },
          "subject": { "type": "string" },
          "predicate": { "type": "string" },
          "object": { "type": "string" },
          "value": {},
          "qualifiers": { "type": "object" },
          "sourceRefs": { "type": "array", "items": { "type": "object", "required": ["sourceId", "locator"], "properties": { "sourceId": { "type": "string" }, "locator": {}, "excerpt": { "type": "string" } } } },
          "verificationStatus": { "enum": ["observed", "documented_intent", "inferred", "unknown", "conflicting"] },
          "explanation": { "type": "string" }
        },
        "anyOf": [{ "required": ["object"] }, { "required": ["value"] }]
      }
    },
    "businessStructures": {
      "type": "object",
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } },
        "flows": { "type": "array", "items": { "type": "object" } },
        "transitions": { "type": "array", "items": { "type": "object" } },
        "rules": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "technicalStructures": {
      "type": "object",
      "properties": {
        "systems": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "apis": { "type": "array", "items": { "type": "string" } },
        "dataEntities": { "type": "array", "items": { "type": "string" } },
        "configurations": { "type": "array", "items": { "type": "string" } },
        "environments": { "type": "array", "items": { "type": "string" } },
        "architectureDecisions": { "type": "array", "items": { "type": "string" } },
        "architectureRevision": { "type": "string" },
        "codeRevision": { "type": "string" },
        "dependencyVersions": { "type": "object" },
        "deploymentVersion": { "type": ["string", "null"] },
        "runtimeConfiguration": { "type": ["object", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "sourceType", "path", "revision", "captureMethod"],
        "properties": {
          "sourceId": { "type": "string" },
          "sourceType": { "type": "string" },
          "uri": { "type": "string" },
          "path": { "type": "string" },
          "revision": { "type": "string" },
          "contentHash": { "type": "string" },
          "lineRange": { "type": "object", "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 } } },
          "section": { "type": "string" },
          "anchor": { "type": "string" },
          "excerpt": { "type": "string", "maxLength": 20000 },
          "captureMethod": { "type": "string" },
          "sensitive": { "type": "boolean" }
        }
      }
    },
    "unknownsAndConflicts": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "kind", "title", "status"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["unknown", "conflict", "missing-source", "unverified-inference", "question"] }, "title": { "type": "string" }, "description": { "type": "string" }, "relatedExternalIds": { "type": "array", "items": { "type": "string" } }, "status": { "type": "string" }, "blocksFormal": { "type": "boolean" } } }
    },
    "importProvenance": {
      "type": "object",
      "required": ["agentRunId", "toolExecutionRefs", "sourceFileRevisions", "extractedAt", "extractionStrategy"],
      "properties": {
        "agentRunId": { "type": "string" },
        "toolExecutionRefs": { "type": "array", "items": { "type": "string" } },
        "sourceFileRevisions": { "type": "object" },
        "extractedAt": { "type": "string", "format": "date-time" },
        "extractionStrategy": { "type": "string" }
      }
    }
  }
}
